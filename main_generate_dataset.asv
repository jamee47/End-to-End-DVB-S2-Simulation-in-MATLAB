clc; clearvars; close all;
% =========================================================================
% MAIN SCRIPT: DVB-S2 Dataset Generation for DL-Based Channel Estimation
% =========================================================================
% Author  : Mohtasim Al Jamee
%
% Pipeline per frame (inner loop):
%   tx_dvbs2_frame  →  channel_tropical  →  rx_dvbs2_frame
%
% Each frame gets a unique channel realisation (A_p, phi resampled).
% BER/NMSE evaluation runs a separate SNR sweep after dataset generation.
% =========================================================================

%% -----------------------------------------------------------------------
%  SECTION 1: CONFIGURATION
% -----------------------------------------------------------------------
cfg = struct();

% --- Frame parameters ---
cfg.FECFrame         = 'normal';
cfg.NumFrames        = 200;         % frames per MODCOD for dataset
cfg.NumEvalFrames    = 100;         % frames averaged per SNR point in eval

% --- MODCODs ---
cfg.MODCODs          = [2];
cfg.MODCODNames      = {'QPSK_1_3'};

% --- Waveform parameters ---
cfg.RolloffFactor        = 0.20;
cfg.FilterSpanInSymbols  = 10;
cfg.SamplesPerSymbol     = 4;
cfg.HasPilots            = true;
cfg.DFL                  = 3008;

% --- Channel parameters ---
cfg.Frequency_GHz    = 20;
cfg.Latitude         = 5.17;
cfg.Altitude_m       = 57;
cfg.ElevationAngle   = 45;
cfg.Polarization     = 'V';

% --- Link budget ---
cfg.G_s_dBi          = 52.0;
cfg.G_r_dBi          = 41.7;
cfg.NoiseBW_Hz       = 50e6;
cfg.NoiseTemp_K      = 207.0;
cfg.Theta3dB_deg     = 0.4;
cfg.BeamOffset_deg   = 0.0;

% --- ITU-R JSON from get_parameters.py ---
cfg.ParamsFile       = 'Parameters/bsson';

% --- SNR ---
cfg.SNR_train_dB     = 30;
cfg.SNR_test_range   = 5:5:30;

% --- DVB-S2 pilot structure (standard) ---
cfg.PilotBlockLen    = 36;
cfg.SlotsPerPilot    = 16;
cfg.SlotSize         = 90;
cfg.PLHeaderLen      = 90;

% --- Output ---
cfg.OutputDir        = 'dataset_output';
if ~exist(cfg.OutputDir,'dir'), mkdir(cfg.OutputDir); end

%% -----------------------------------------------------------------------
%  Seed RNG once — channel_tropical uses rand() per frame
% -----------------------------------------------------------------------
rng('shuffle');

%% -----------------------------------------------------------------------
%  Load ITU-R parameters once (location/frequency fixed for all frames)
% -----------------------------------------------------------------------
fprintf('>>> Loading ITU-R parameters...\n');
itu = load_itu_params(cfg.ParamsFile);

fprintf('=============================================================\n');
fprintf(' DVB-S2 Dataset Generator — Tropical Fading Channel\n');
fprintf(' Frames: %d per MODCOD | FECFrame: %s | EvalFrames: %d/SNR\n', ...
    cfg.NumFrames, cfg.FECFrame, cfg.NumEvalFrames);
fprintf('=============================================================\n\n');

%% -----------------------------------------------------------------------
%  SECTION 2-4: MAIN LOOP — dataset generation
% -----------------------------------------------------------------------
allResults  = struct();
allPilotPos = struct();   % pilot positions per MODCOD — reused in eval

for modIdx = 1:length(cfg.MODCODs)

    cfg.CurrentMODCOD     = cfg.MODCODs(modIdx);
    cfg.CurrentMODCODName = cfg.MODCODNames{modIdx};

    fprintf('>>> MODCOD %d (%s) — generating %d frames...\n', ...
        cfg.CurrentMODCOD, cfg.CurrentMODCODName, cfg.NumFrames);

    %% Detect pilot positions once from a reference frame
    fprintf('    [TX] Detecting pilot structure...\n');
    txRef    = tx_dvbs2_frame(cfg);
    pilotPos = detect_pilot_positions(txRef, cfg);

    if isempty(pilotPos)
        error('[MAIN] No pilots detected for MODCOD %d. Check HasPilots=true.', ...
            cfg.CurrentMODCOD);
    end

    % Store pilot positions for evaluation step
    allPilotPos.(cfg.CurrentMODCODName) = pilotPos;
    numPilotBlocks = length(pilotPos);

    %% Pre-allocate dataset matrix
    numFeatureCols = numPilotBlocks * 6;
    % Columns: features | Re_hk Im_hk Re_htilde Im_htilde SNR RainAtten BER NMSE
    numMetaCols    = 8;
    datasetMatrix  = zeros(cfg.NumFrames, numFeatureCols + numMetaCols);

    %% Inner loop — one unique frame per iteration
    fprintf('    [LOOP] Frames: ');
    for frameIdx = 1:cfg.NumFrames

        if mod(frameIdx, 50) == 0
            fprintf('%d ', frameIdx);
        end

        % 1. Transmit one frame
        txFrame = tx_dvbs2_frame(cfg);

        % 2. Apply unique channel realisation
        chFrame = channel_tropical(txFrame, cfg, cfg.SNR_train_dB, itu);

        % 3. Receiver — pilot extraction, LS estimation, BER, NMSE
        rxFrame = rx_dvbs2_frame(txFrame, chFrame, cfg, pilotPos);

        % 4. Build dataset row
        featureRow = reshape(rxFrame.X_in', 1, numFeatureCols);
        datasetMatrix(frameIdx, :) = [
            featureRow, ...
            real(chFrame.h_true),  imag(chFrame.h_true), ...
            real(chFrame.h_tilde), imag(chFrame.h_tilde), ...
            chFrame.snr_dB,        chFrame.rainAtten_dB, ...
            rxFrame.BER_LS,        rxFrame.NMSE_LS
        ];
    end
    fprintf('\n');

    %% Per-MODCOD summary
    berCol  = datasetMatrix(:, numFeatureCols + 7);
    nmseCol = datasetMatrix(:, numFeatureCols + 8);
    rainCol = datasetMatrix(:, numFeatureCols + 6);
    fprintf('    [DONE] %s | Mean BER=%.4f | Mean NMSE=%.4e | Rain=[%.2f,%.2f] dB\n', ...
        cfg.CurrentMODCODName, mean(berCol), mean(nmseCol), ...
        min(rainCol), max(rainCol));

    %% Store results
    allResults.(cfg.CurrentMODCODName).datasetMatrix  = datasetMatrix;
    allResults.(cfg.CurrentMODCODName).numPilotBlocks = numPilotBlocks;
    allResults.(cfg.CurrentMODCODName).pilotPos       = pilotPos;
    allResults.(cfg.CurrentMODCODName).MODCOD         = cfg.CurrentMODCOD;
    allResults.(cfg.CurrentMODCODName).MODCODName     = cfg.CurrentMODCODName;
    allResults.(cfg.CurrentMODCODName).snr_dB         = cfg.SNR_train_dB;
end

%% -----------------------------------------------------------------------
%  SECTION 5: EXPORT DATASET TO CSV
% -----------------------------------------------------------------------
fprintf('\n>>> Exporting dataset to CSV...\n');
export_dataset_csv(allResults, cfg);

%% -----------------------------------------------------------------------
%  SECTION 6: BER / NMSE EVALUATION ACROSS SNR RANGE
% -----------------------------------------------------------------------
fprintf('\n>>> Running BER/NMSE evaluation...\n');
evaluate_ber_nmse(cfg, itu, allPilotPos);

fprintf('\n=== Complete. Files saved in: %s ===\n', cfg.OutputDir);